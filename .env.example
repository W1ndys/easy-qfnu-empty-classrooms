# QFNU CAS 登录配置
# 复制此文件为 .env 并填写真实信息
#
# Docker Compose 部署步骤：
# 1. cp .env.example .env
# 2. 填写真实的学号、密码和管理员信息
# 3. docker compose up -d --build

# ---- 敏感信息（必须配置） ----

# QFNU 教务系统账号
QFNU_USERNAME=你的学号
QFNU_PASSWORD=你的密码

# OCR 服务基础地址，用于识别强智教务系统验证码
# 示例：http://127.0.0.1:8000 或 http://ddddocr:8000
OCR_URL=http://127.0.0.1:8000

# 管理后台账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置一个强密码

# JWT 签名密钥（建议使用 32 位以上随机字符串，留空则每次重启自动生成）
JWT_SECRET=

# PostgreSQL 配置。生产环境必须替换默认密码；如密码包含 URL 特殊字符，
# DATABASE_URL 中的密码需要进行 URL 编码。
POSTGRES_DB=easy_qfnu_kjs
POSTGRES_USER=easy_qfnu_kjs
POSTGRES_PASSWORD=change-me

# 本机运行后端或迁移工具时使用；Docker Compose 会自动改用 postgres 容器主机名。
DATABASE_URL=postgres://easy_qfnu_kjs:change-me@127.0.0.1:5432/easy_qfnu_kjs?sslmode=disable

# 仅迁移旧 SQLite 时使用。查询日志历史上按 UTC 存储；公告若曾在
# TZ=Asia/Shanghai 的旧容器中写入，可将公告时区改为 Asia/Shanghai。
SQLITE_QUERY_LOG_TIMEZONE=UTC
SQLITE_ANNOUNCEMENT_TIMEZONE=UTC

# ---- 服务配置 ----

# 后端监听端口
PORT=8080
# 建议生产环境保持 release
GIN_MODE=release
# Caddy 和前端 Nginx 所在的 Docker 可信代理网段，多个网段用逗号分隔
TRUSTED_PROXY_CIDRS=172.22.0.0/16,172.25.0.0/16
BACKEND_PORT=8080
